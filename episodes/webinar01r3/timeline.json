{"lines": [{"text": "Who believed next?", "words": [["Who", 0.11999999999999744, 0.2909999999999968], ["believed", 0.37599999999999767, 0.6749999999999972], ["next?", 0.8029999999999973, 1.0159999999999982]], "start": 0.11999999999999744, "end": 1.0159999999999982, "key": "next?"}, {"text": "‘Ali. Zayd ibn Harithah. Abu Bakr,", "words": [["‘Ali.", 1.6359999999999957, 2.1199999999999903], ["Zayd", 2.488999999999997, 2.830999999999996], ["ibn", 2.958999999999996, 3.086999999999996], ["Harithah.", 3.1289999999999907, 3.6409999999999982], ["Abu", 3.982999999999997, 4.323999999999991], ["Bakr,", 4.366999999999997, 4.750999999999998]], "start": 1.6359999999999957, "end": 4.750999999999998, "key": "Bakr,"}, {"text": "and those he invited.", "words": [["and", 4.878999999999998, 5.219999999999992], ["those", 5.347999999999992, 5.561], ["he", 5.731999999999992, 5.859999999999992], ["invited.", 5.902999999999999, 6.243999999999993]], "start": 4.878999999999998, "end": 6.243999999999993, "key": "invited."}, {"text": "The accounts differ on who came first among the men,", "words": [["The", 6.863999999999997, 7.077999999999996], ["accounts", 7.119999999999997, 7.503999999999984], ["differ", 7.631999999999984, 7.93099999999999], ["on", 8.101999999999997, 8.229999999999997], ["who", 8.31499999999999, 8.44299999999999], ["came", 8.485999999999997, 8.655999999999985], ["first", 8.783999999999985, 9.039999999999985], ["among", 9.253999999999984, 9.381999999999984], ["the", 9.466999999999992, 9.551999999999985], ["men,", 9.594999999999992, 9.765999999999984]], "start": 6.863999999999997, "end": 9.765999999999984, "key": "first"}, {"text": "and the reasons they differ are worth knowing.", "words": [["and", 10.021999999999984, 10.362999999999992], ["the", 10.405999999999985, 10.533999999999985], ["reasons", 10.575999999999986, 10.746999999999993], ["they", 11.002999999999993, 11.130999999999993], ["differ", 11.173999999999985, 11.514999999999993], ["are", 11.599999999999987, 11.770999999999994], ["worth", 11.855999999999987, 12.069999999999986], ["knowing.", 12.239999999999988, 12.367999999999988]], "start": 10.021999999999984, "end": 12.367999999999988, "key": "knowing."}, {"text": "What did Khadijah know?", "words": [["What", 12.96799999999999, 13.22399999999999], ["did", 13.266999999999996, 13.394999999999996], ["Khadijah", 13.436999999999998, 13.906999999999996], ["know?", 13.948999999999998, 14.11999999999999]], "start": 12.96799999999999, "end": 14.11999999999999, "key": "Khadijah"}, {"text": "Saturday, the ninth of January.", "words": [["Saturday,", 14.66999999999999, 15.077999999999989], ["the", 15.53199999999999, 15.71399999999999], ["ninth", 15.75899999999999, 16.07699999999999], ["of", 16.16799999999999, 16.21299999999999], ["January.", 16.303999999999988, 16.75799999999999]], "start": 14.66999999999999, "end": 16.75799999999999, "key": "January."}, {"text": "Nine p.m., Singapore time.", "words": [["Nine", 17.21199999999999, 17.43899999999999], ["p.m.,", 17.61999999999999, 17.937999999999988], ["Singapore", 18.16499999999999, 18.79999999999999], ["time.", 18.89099999999999, 19.117999999999988]], "start": 17.21199999999999, "end": 19.117999999999988, "key": "Singapore"}], "voice_end": 19.617999999999988, "total": 22.817999999999987}