{"lines": [{"text": "How did revelation begin?", "words": [["How", 0.11999999999999922, 0.43799999999999883], ["did", 0.5739999999999998, 0.7099999999999991], ["revelation", 0.8009999999999984, 1.254999999999999], ["begin?", 1.4819999999999993, 1.6629999999999985]], "start": 0.11999999999999922, "end": 1.6629999999999985, "key": "begin?"}, {"text": "The account of ‘A’ishah takes us through it, step by step:", "words": [["The", 2.0429999999999993, 2.2139999999999986], ["account", 2.2560000000000002, 2.5549999999999997], ["of", 2.683, 2.7680000000000007], ["‘A’ishah", 2.811, 3.3659999999999997], ["takes", 3.4510000000000005, 3.622], ["us", 3.75, 3.878], ["through", 3.963000000000001, 4.175999999999995], ["it,", 4.219000000000001, 4.347000000000001], ["step", 4.602999999999994, 4.902000000000001], ["by", 5.030000000000001, 5.158000000000001], ["step:", 5.242999999999995, 5.498999999999995]], "start": 2.0429999999999993, "end": 5.498999999999995, "key": "step"}, {"text": "truthful dreams, a retreat,", "words": [["truthful", 6.010999999999996, 6.437999999999995], ["dreams,", 6.522999999999996, 6.9069999999999965], ["a", 7.2479999999999976, 7.333999999999996], ["retreat,", 7.375999999999998, 7.759999999999998]], "start": 6.010999999999996, "end": 7.759999999999998, "key": "dreams,"}, {"text": "the opening words of Surat al-‘Alaq,", "words": [["the", 8.271999999999998, 8.485999999999997], ["opening", 8.527999999999999, 8.741999999999997], ["words", 8.997999999999998, 9.253999999999998], ["of", 9.381999999999998, 9.466999999999999], ["Surat", 9.552, 9.936], ["al-‘Alaq,", 9.979, 10.405999999999999]], "start": 8.271999999999998, "end": 10.405999999999999, "key": "al-‘Alaq,"}, {"text": "and the return home.", "words": [["and", 10.619, 10.918], ["the", 11.088000000000001, 11.131], ["return", 11.174, 11.302], ["home.", 11.643, 11.814]], "start": 10.619, "end": 11.814, "key": "home."}, {"text": "What did Khadijah know?", "words": [["What", 12.414000000000001, 12.670000000000002], ["did", 12.713000000000008, 12.841000000000008], ["Khadijah", 12.88300000000001, 13.353000000000009], ["know?", 13.39500000000001, 13.566000000000003]], "start": 12.414000000000001, "end": 13.566000000000003, "key": "Khadijah"}, {"text": "Saturday, the ninth of January.", "words": [["Saturday,", 14.116000000000001, 14.524000000000001], ["the", 14.978000000000002, 15.160000000000002], ["ninth", 15.205000000000002, 15.523000000000001], ["of", 15.614000000000003, 15.659000000000002], ["January.", 15.750000000000002, 16.204]], "start": 14.116000000000001, "end": 16.204, "key": "January."}, {"text": "Nine p.m., Singapore time.", "words": [["Nine", 16.658, 16.885], ["p.m.,", 17.066000000000003, 17.384], ["Singapore", 17.611, 18.246000000000002], ["time.", 18.337000000000003, 18.564]], "start": 16.658, "end": 18.564, "key": "Singapore"}], "voice_end": 19.064, "total": 22.264}