{"lines": [{"text": "Before Hira, there was the day of the Black Stone.", "words": [["Before", 0.1200000000000001, 0.4370000000000003], ["Hira,", 0.8000000000000007, 1.2540000000000004], ["there", 1.7080000000000002, 1.9350000000000005], ["was", 2.0260000000000007, 2.207], ["the", 2.3440000000000003, 2.4800000000000004], ["day", 2.5250000000000004, 2.7520000000000007], ["of", 2.843, 2.934], ["the", 3.024000000000001, 3.115], ["Black", 3.1609999999999996, 3.433], ["Stone.", 3.569000000000001, 3.8870000000000005]], "start": 0.1200000000000001, "end": 3.8870000000000005, "key": "Stone."}, {"text": "When Quraysh rebuilt the Ka‘bah,", "words": [["When", 4.2669999999999995, 4.437999999999999], ["Quraysh", 4.523999999999997, 4.864999999999998], ["rebuilt", 4.949999999999999, 5.248999999999999], ["the Ka‘bah,", 5.334, 5.888999999999999]], "start": 4.2669999999999995, "end": 5.888999999999999, "key": "the Ka‘bah,"}, {"text": "the clans fell into dispute over who would place the Black Stone.", "words": [["the", 6.273, 6.3580000000000005], ["clans", 6.401, 6.657], ["fell", 6.870000000000001, 7.041], ["into", 7.083000000000002, 7.1690000000000005], ["dispute", 7.297000000000001, 7.766000000000002], ["over", 7.852, 8.022000000000002], ["who", 8.193000000000001, 8.364], ["would", 8.406000000000002, 8.491000000000003], ["place", 8.577000000000002, 8.747000000000003], ["the", 8.875000000000004, 8.961000000000002], ["Black", 9.003000000000004, 9.217000000000002], ["Stone.", 9.302000000000003, 9.558000000000003]], "start": 6.273, "end": 9.558000000000003, "key": "dispute"}, {"text": "They accepted his judgement.", "words": [["They", 10.178, 10.306000000000001], ["accepted", 10.434000000000001, 10.860000000000003], ["his", 10.903000000000002, 11.031000000000002], ["judgement.", 11.115999999999996, 11.543000000000003]], "start": 10.178, "end": 11.543000000000003, "key": "judgement."}, {"text": "And the settlement let them all share the honour.", "words": [["And", 11.883999999999997, 12.011999999999997], ["the", 12.054999999999996, 12.139999999999997], ["settlement", 12.182999999999996, 12.653000000000002], ["let", 12.909000000000002, 13.037000000000003], ["them", 13.078999999999997, 13.206999999999997], ["all", 13.249999999999996, 13.505999999999997], ["share", 13.677000000000003, 13.932999999999996], ["the", 14.060999999999996, 14.145999999999997], ["honour.", 14.188999999999997, 14.401999999999997]], "start": 11.883999999999997, "end": 14.401999999999997, "key": "honour."}, {"text": "What did Khadijah know?", "words": [["What", 15.001999999999995, 15.257999999999996], ["did", 15.301000000000002, 15.429000000000002], ["Khadijah", 15.471000000000004, 15.941000000000003], ["know?", 15.983000000000004, 16.153999999999996]], "start": 15.001999999999995, "end": 16.153999999999996, "key": "Khadijah"}, {"text": "Saturday, the ninth of January.", "words": [["Saturday,", 16.703999999999997, 17.111999999999995], ["the", 17.565999999999995, 17.747999999999998], ["ninth", 17.792999999999996, 18.110999999999997], ["of", 18.201999999999995, 18.246999999999996], ["January.", 18.337999999999994, 18.791999999999994]], "start": 16.703999999999997, "end": 18.791999999999994, "key": "January."}, {"text": "Nine p.m., Singapore time.", "words": [["Nine", 19.245999999999995, 19.472999999999995], ["p.m.,", 19.653999999999996, 19.971999999999994], ["Singapore", 20.198999999999995, 20.833999999999996], ["time.", 20.924999999999997, 21.151999999999994]], "start": 19.245999999999995, "end": 21.151999999999994, "key": "Singapore"}], "voice_end": 21.651999999999994, "total": 24.851999999999993}