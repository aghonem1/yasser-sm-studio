{"lines": [{"text": "A man comes home from the cave of Hira, trembling.", "words": [["A", 0.299, 0.427], ["man", 0.469, 0.768], ["comes", 0.853, 0.981], ["home", 1.109, 1.28], ["from", 1.365, 1.536], ["the", 1.579, 1.664], ["cave", 1.707, 1.963], ["of", 2.005, 2.091], ["Hira,", 2.133, 2.56], ["trembling.", 2.901, 3.371]], "start": 0.299, "end": 3.371}, {"text": "He has just received the first words of revelation.", "words": [["He", 3.871, 4.042], ["has", 4.085000000000001, 4.17], ["just", 4.255000000000001, 4.510999999999999], ["received", 4.682, 4.981], ["the", 5.109, 5.194000000000001], ["first", 5.237, 5.577999999999999], ["words", 5.7490000000000006, 5.962], ["of", 6.047000000000001, 6.133000000000001], ["revelation.", 6.175000000000001, 6.602]], "start": 3.871, "end": 6.602}, {"text": "The first person to hear it is his wife, Khadijah.", "words": [["The", 7.102, 7.23], ["first", 7.272, 7.443], ["person", 7.571, 7.741999999999999], ["to", 7.911999999999999, 8.04], ["hear", 8.083, 8.254], ["it", 8.339, 8.424], ["is", 8.552, 8.68], ["his", 8.722999999999999, 8.850999999999999], ["wife,", 8.936, 9.15], ["Khadijah.", 9.491, 10.003]], "start": 7.102, "end": 10.003}, {"text": "And she reassures him.", "words": [["And", 10.302, 10.6], ["she", 10.642999999999999, 10.814], ["reassures", 10.856, 11.326], ["him.", 11.454, 11.624]], "start": 10.302, "end": 11.624}, {"text": "Her answer was not a guess.", "words": [["Her", 11.879999999999999, 12.008], ["answer", 12.094, 12.35], ["was", 12.776, 13.032], ["not", 13.118, 13.374], ["a", 13.459, 13.502], ["guess.", 13.544, 13.758]], "start": 11.879999999999999, "end": 13.758}, {"text": "She had known him for years,", "words": [["She", 14.251, 14.422], ["had", 14.507, 14.635], ["known", 14.721, 14.934], ["him", 15.062, 15.147], ["for", 15.233, 15.361], ["years,", 15.403, 15.659]], "start": 14.251, "end": 15.659}, {"text": "in trade and in marriage.", "words": [["in", 16.159000000000002, 16.287000000000003], ["trade", 16.373, 16.629], ["and", 16.842000000000002, 17.098000000000003], ["in", 17.226000000000003, 17.311], ["marriage.", 17.354000000000003, 17.695]], "start": 16.159000000000002, "end": 17.695}, {"text": "So what had she seen?", "words": [["So", 18.195, 18.408], ["what", 18.622, 18.835], ["had", 18.92, 19.048000000000002], ["she", 19.091, 19.219], ["seen?", 19.262, 19.475]], "start": 18.195, "end": 19.475}, {"text": "One hour, live and free.", "words": [["One", 19.816000000000003, 20.03], ["hour,", 20.072000000000003, 20.200000000000003], ["live", 20.584, 20.84], ["and", 21.011000000000003, 21.096], ["free.", 21.139000000000003, 21.310000000000002]], "start": 19.816000000000003, "end": 21.310000000000002}, {"text": "What did Khadijah know?", "words": [["What", 21.810000000000002, 22.066000000000003], ["did", 22.109, 22.194000000000003], ["Khadijah", 22.237000000000002, 22.706000000000003], ["know?", 22.749000000000002, 22.877000000000002]], "start": 21.810000000000002, "end": 22.877000000000002}, {"text": "Register at the link.", "words": [["Register", 23.377000000000002, 23.676000000000002], ["at", 23.889000000000003, 23.974000000000004], ["the", 24.017000000000003, 24.102000000000004], ["link.", 24.145000000000003, 24.273000000000003]], "start": 23.377000000000002, "end": 24.273000000000003}], "voice_end": 24.873000000000005, "total": 28.473000000000006}