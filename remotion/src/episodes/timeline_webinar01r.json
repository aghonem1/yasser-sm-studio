{"lines": [{"text": "A man comes home from the cave of Hira, trembling.", "words": [["A", 0.299, 0.427], ["man", 0.469, 0.768], ["comes", 0.853, 0.981], ["home", 1.109, 1.28], ["from", 1.365, 1.536], ["the", 1.579, 1.664], ["cave", 1.707, 1.963], ["of", 2.005, 2.091], ["Hira,", 2.133, 2.56], ["trembling.", 2.901, 3.371]], "start": 0.299, "end": 3.371}, {"text": "He has just received the first words of revelation.", "words": [["He", 3.871, 4.042], ["has", 4.085000000000001, 4.17], ["just", 4.255000000000001, 4.510999999999999], ["received", 4.682, 4.981], ["the", 5.109, 5.194000000000001], ["first", 5.237, 5.577999999999999], ["words", 5.7490000000000006, 5.962], ["of", 6.047000000000001, 6.133000000000001], ["revelation.", 6.175000000000001, 6.602]], "start": 3.871, "end": 6.602}, {"text": "The first person to hear it is his wife, Khadijah.", "words": [["The", 7.102, 7.23], ["first", 7.272, 7.443], ["person", 7.571, 7.741999999999999], ["to", 7.911999999999999, 8.04], ["hear", 8.083, 8.254], ["it", 8.339, 8.424], ["is", 8.552, 8.68], ["his", 8.722999999999999, 8.850999999999999], ["wife,", 8.936, 9.15], ["Khadijah.", 9.491, 10.003]], "start": 7.102, "end": 10.003}, {"text": "And she reassures him.", "words": [["And", 10.302, 10.6], ["she", 10.642999999999999, 10.814], ["reassures", 10.856, 11.326], ["him.", 11.454, 11.624]], "start": 10.302, "end": 11.624}, {"text": "Her answer was not a guess.", "words": [["Her", 11.879999999999999, 12.008], ["answer", 12.094, 12.35], ["was", 12.776, 13.032], ["not", 13.118, 13.374], ["a", 13.459, 13.502], ["guess.", 13.544, 13.758]], "start": 11.879999999999999, "end": 13.758}, {"text": "She had known him for years,", "words": [["She", 14.251, 14.422], ["had", 14.507, 14.635], ["known", 14.721, 14.934], ["him", 15.062, 15.147], ["for", 15.233, 15.361], ["years,", 15.403, 15.659]], "start": 14.251, "end": 15.659}, {"text": "in trade and in marriage.", "words": [["in", 16.159000000000002, 16.287000000000003], ["trade", 16.373, 16.629], ["and", 16.842000000000002, 17.098000000000003], ["in", 17.226000000000003, 17.311], ["marriage.", 17.354000000000003, 17.695]], "start": 16.159000000000002, "end": 17.695}, {"text": "So what had she seen?", "words": [["So", 18.195, 18.408], ["what", 18.622, 18.835], ["had", 18.92, 19.048000000000002], ["she", 19.091, 19.219], ["seen?", 19.262, 19.475]], "start": 18.195, "end": 19.475}, {"text": "Join me for one hour, live and free.", "words": [["Join", 20.075000000000003, 20.331000000000003], ["me", 20.459000000000003, 20.587000000000003], ["for", 20.63000000000001, 20.75800000000001], ["one", 20.843000000000004, 21.01400000000001], ["hour,", 21.099000000000004, 21.27000000000001], ["live", 21.697000000000003, 21.995000000000005], ["and", 22.16600000000001, 22.337000000000003], ["free.", 22.42200000000001, 22.635000000000005]], "start": 20.075000000000003, "end": 22.635000000000005}, {"text": "We will read the accounts together,", "words": [["We", 23.085000000000008, 23.298000000000016], ["will", 23.341000000000008, 23.426000000000016], ["read", 23.46900000000001, 23.63900000000001], ["the", 23.682000000000016, 23.810000000000016], ["accounts", 23.85300000000001, 24.194000000000017], ["together,", 24.322000000000017, 24.578000000000017]], "start": 23.085000000000004, "end": 24.578000000000017}, {"text": "and follow this one question:", "words": [["and", 24.878000000000014, 25.006000000000014], ["follow", 25.092000000000013, 25.30500000000002], ["this", 25.476000000000013, 25.604000000000013], ["one", 25.68900000000002, 25.902000000000015], ["question:", 26.030000000000015, 26.244000000000014]], "start": 24.878000000000018, "end": 26.244000000000014}, {"text": "What did Khadijah know?", "words": [["What", 26.694000000000017, 26.950000000000017], ["did", 26.993000000000023, 27.121000000000024], ["Khadijah", 27.163000000000025, 27.633000000000024], ["know?", 27.675000000000026, 27.846000000000018]], "start": 26.694000000000013, "end": 27.846000000000018}, {"text": "Saturday, the ninth of January.", "words": [["Saturday,", 28.44600000000002, 28.854000000000017], ["the", 29.308000000000018, 29.490000000000016], ["ninth", 29.535000000000018, 29.85300000000002], ["of", 29.944000000000017, 29.98900000000002], ["January.", 30.08000000000002, 30.534000000000017]], "start": 28.44600000000002, "end": 30.534000000000017}, {"text": "Nine p.m., Singapore time.", "words": [["Nine", 30.988000000000017, 31.215000000000018], ["p.m.,", 31.39600000000002, 31.714000000000016], ["Singapore", 31.941000000000017, 32.57600000000002], ["time.", 32.667000000000016, 32.89400000000002]], "start": 30.988000000000017, "end": 32.89400000000002}], "voice_end": 33.39400000000002, "total": 36.79400000000002}