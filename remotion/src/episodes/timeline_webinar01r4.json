{"lines": [{"text": "Khadijah had known him for years.", "words": [["Khadijah", 0.11999999999999922, 0.8919999999999977], ["had", 1.118999999999998, 1.7089999999999979], ["known", 1.799999999999999, 2.1179999999999986], ["him", 2.2989999999999977, 2.480999999999998], ["for", 2.571999999999999, 2.7529999999999983], ["years.", 2.8439999999999976, 3.251999999999999]], "start": 0.11999999999999922, "end": 3.251999999999999, "key": "years."}, {"text": "And when the call went public, at Safa,", "words": [["And", 3.632000000000005, 3.8020000000000067], ["when", 3.845000000000013, 4.016000000000005], ["the", 4.058000000000007, 4.1440000000000055], ["call", 4.186000000000007, 4.3570000000000135], ["went", 4.442000000000007, 4.570000000000007], ["public,", 4.6980000000000075, 4.869000000000014], ["at", 5.466000000000008, 5.594000000000008], ["Safa,", 5.680000000000007, 6.192000000000007]], "start": 3.632000000000005, "end": 6.192000000000007, "key": "Safa,"}, {"text": "someone else who had known him before revelation", "words": [["someone", 6.704000000000008, 6.960000000000008], ["else", 7.173000000000002, 7.429000000000002], ["who", 7.685000000000002, 7.77000000000001], ["had", 7.813000000000002, 7.9410000000000025], ["known", 8.02600000000001, 8.240000000000009], ["him", 8.36800000000001, 8.49600000000001], ["before", 8.581000000000003, 8.709000000000003], ["revelation", 9.00800000000001, 9.434000000000012]], "start": 6.704000000000008, "end": 9.434000000000012, "key": "revelation"}, {"text": "gave a very different answer.", "words": [["gave", 9.733000000000004, 10.202000000000012], ["a", 10.288000000000011, 10.373000000000005], ["very", 10.416000000000011, 10.714000000000013], ["different", 10.885000000000005, 11.056000000000012], ["answer.", 11.312000000000012, 11.525000000000006]], "start": 9.733000000000004, "end": 11.525000000000006, "key": "different"}, {"text": "Abu Lahab.", "words": [["Abu", 12.14500000000001, 12.443000000000012], ["Lahab.", 12.486000000000004, 12.827000000000012]], "start": 12.14500000000001, "end": 12.827000000000012, "key": "Lahab."}, {"text": "Two people who knew him.", "words": [["Two", 13.211000000000013, 13.425000000000011], ["people", 13.467000000000013, 13.638000000000005], ["who", 13.851000000000013, 13.979000000000013], ["knew", 14.022000000000006, 14.193000000000012], ["him.", 14.278000000000006, 14.449000000000012]], "start": 13.211000000000013, "end": 14.449000000000012, "key": "people"}, {"text": "Two opposite answers.", "words": [["Two", 14.918000000000006, 15.131000000000014], ["opposite", 15.174000000000007, 15.771], ["answers.", 15.857000000000014, 16.283]], "start": 14.918000000000006, "end": 16.283, "key": "opposite"}, {"text": "What did Khadijah know?", "words": [["What", 16.882999999999996, 17.138999999999996], ["did", 17.182000000000002, 17.310000000000002], ["Khadijah", 17.352000000000004, 17.822000000000003], ["know?", 17.864000000000004, 18.034999999999997]], "start": 16.882999999999996, "end": 18.034999999999997, "key": "Khadijah"}, {"text": "Saturday, the ninth of January.", "words": [["Saturday,", 18.585000000000004, 18.993000000000002], ["the", 19.447000000000003, 19.629000000000005], ["ninth", 19.674000000000003, 19.992000000000004], ["of", 20.083000000000002, 20.128000000000004], ["January.", 20.219, 20.673000000000002]], "start": 18.585000000000004, "end": 20.673000000000002, "key": "January."}, {"text": "Nine p.m., Singapore time.", "words": [["Nine", 21.127000000000002, 21.354000000000003], ["p.m.,", 21.535000000000004, 21.853], ["Singapore", 22.080000000000002, 22.715000000000003], ["time.", 22.806000000000004, 23.033]], "start": 21.127000000000002, "end": 23.033, "key": "Singapore"}], "voice_end": 23.533, "total": 26.733}